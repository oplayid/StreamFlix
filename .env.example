# =============================================================================
# OPLAY.ID — ENVIRONMENT VARIABLES (dummy values, sesuaikan dengan punya Anda)
# =============================================================================
# Salin file ini jadi .env untuk development:  cp .env.example .env
# Variabel VITE_* di-inline saat BUILD. Sisanya dibaca saat RUNTIME (Coolify).
# Jangan pernah commit .env yang berisi kredensial asli.

# -----------------------------------------------------------------------------
# MongoDB (runtime / server-only)
# -----------------------------------------------------------------------------
MONGODB_URI="mongodb://user:password@localhost:27017/oplayid?authSource=admin"
# Opsional. Kalau kosong, nama DB diambil dari MONGODB_URI (fallback lama: streamflix,
# dipertahankan agar data existing tidak hilang — sebaiknya set eksplisit di produksi).
MONGODB_DB="oplayid"

# -----------------------------------------------------------------------------
# Pocket ID OIDC (runtime / server-only)
# -----------------------------------------------------------------------------
# Base URL instance Pocket ID. POCKET_ID_URL adalah alias untuk POCKET_ID_ISSUER.
POCKET_ID_ISSUER="https://pocketid.example.com"
POCKET_ID_URL="https://pocketid.example.com"
# Harus SAMA PERSIS dengan client ID yang didaftarkan di Pocket ID.
POCKET_ID_CLIENT_ID="oplay-id"
# Kosongkan jika client Anda adalah public client (tanpa secret).
POCKET_ID_CLIENT_SECRET="your-pocket-id-client-secret"
# Opsional jika APP_URL diisi. Harus SAMA PERSIS dengan redirect URI di Pocket ID.
POCKET_ID_REDIRECT_URI="https://movie.oplay.id/api/auth/callback"

# URL publik aplikasi ini (dipakai cookie, redirect, dan link notifikasi).
APP_URL="https://movie.oplay.id"

# -----------------------------------------------------------------------------
# Web Push / VAPID (build-time untuk public key, runtime untuk private key)
# -----------------------------------------------------------------------------
# Pasangan key di bawah adalah DUMMY yang valid (hasil generate-vapid-keys).
# Bisa dipakai untuk testing lokal, tapi sebaiknya generate sendiri untuk produksi:
#   npx web-push generate-vapid-keys
VITE_WEB_PUSH_PUBLIC_KEY="BCe6NQf1ZaYrOoavWpowuBYXdRs_MI_9MvyXc3sYELPJsCCTntb9AYddWkQMaSjIZev2S3uUO6xKA-5nWoJpXSs"
WEB_PUSH_PUBLIC_KEY="BCe6NQf1ZaYrOoavWpowuBYXdRs_MI_9MvyXc3sYELPJsCCTntb9AYddWkQMaSjIZev2S3uUO6xKA-5nWoJpXSs"
WEB_PUSH_PRIVATE_KEY="7KAXZrHUgSDKwz9wjzNTBX2fg4dIWV3sKpkxOFAgrAQ"
WEB_PUSH_SUBJECT="mailto:admin@example.com"

# -----------------------------------------------------------------------------
# TMDB (VITE_* build-time, tanpa prefix server-side)
# -----------------------------------------------------------------------------
VITE_TMDB_API_KEY="your-tmdb-api-key"
TMDB_API_KEY="your-tmdb-api-key"

# URL publik (juga dipakai beberapa helper lama). Samakan dengan APP_URL.
VITE_SITE_URL="https://movie.oplay.id"

# -----------------------------------------------------------------------------
# OPLAY.ID AI / NVIDIA NIM (runtime / server-only, opsional)
# -----------------------------------------------------------------------------
NVIDIA_API_KEY="your-nvidia-api-key"
# NVIDIA_NIM_API_KEY adalah alias untuk NVIDIA_API_KEY.
NVIDIA_NIM_API_KEY="your-nvidia-api-key"
NVIDIA_MODEL="nvidia/nemotron-3-ultra-550b-a55b"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (opsional)
# -----------------------------------------------------------------------------
VITE_TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# -----------------------------------------------------------------------------
# Cron & archive endpoints (runtime / server-only)
# -----------------------------------------------------------------------------
CRON_SECRET="your-random-cron-secret"
WAYBACK_ARCHIVE_KEY="your-random-archive-key"

# -----------------------------------------------------------------------------
# Server (opsional; default sudah benar untuk Docker/Coolify)
# -----------------------------------------------------------------------------
PORT="3000"
HOST="0.0.0.0"

# -----------------------------------------------------------------------------
# Catatan identitas internal (bukan branding, sengaja dipertahankan)
# -----------------------------------------------------------------------------
# - GHCR image : ghcr.io/oplayid/streamflix:latest  (jangan diubah tanpa redeploy Coolify)
# - Android id : com.itiswayneee.streamflix          (_id paket, bukan nama aplikasi)
# - Mongo DB   : streamflix jika MONGODB_DB/MONGODB_URI tidak menentukan nama DB
